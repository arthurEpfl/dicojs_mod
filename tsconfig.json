{
  "compilerOptions": {
    "target": "ES5",
    "lib": ["ES5", "DOM"],

    "strict": true,

    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "importHelpers": true,
    "downlevelIteration": true,
    
    "declaration": true,
    "declarationDir": "dist/node",
    
    "typeRoots": ["./node_modules/@types"],

    "outDir": "dist",
    "baseUrl": "."
  },
  "include": ["src/**/*.ts"]
}
